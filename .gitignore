# Plugin runtime state. The real directory lives under ~/.dsh/remote-control;
# this entry covers a checkout-local override (a dev/test store pointed at the
# repo) so a device table or an audit trail can never be committed by accident.
.dsh-remote-control/

# Temp files written next to devices.json by the atomic write. They are renamed
# away on success; a crash can leave one behind.
*.tmp
